  "units": [
    {
      "guide": {
        "summary": "Week 0 introduces computer-science thinking using Scratch, a drag-and-drop language. You focus on ideas like sequence, loops, conditions, and variables without worrying about typing code yet.",
        "whatToDo": [
          "Watch the Week 0 lecture and follow along with the Scratch demos.",
          "Open Scratch and rebuild a small example to get comfortable with the blocks.",
          "Start Problem Set 0 once the core ideas feel familiar."
        ],
        "doneLooksLike": [
          "You can explain sequence, loops, and conditions in plain words.",
          "You have a working Scratch project that does something on purpose.",
          "Problem Set 0 is finished and submitted."
        ],
        "reflectionPrompt": "Which programming idea finally clicked for you this week, and what made it click?"
      },
      "id": "week-0",
      "link": {
        "label": "Week 0 on CS50.harvard.edu",
        "url": "https://cs50.harvard.edu/x/weeks/0/"
      }
    },
    {
      "guide": {
        "summary": "Week 1 moves from Scratch to C, a text-based language. The ideas are the same as Week 0, but now you write them as code and compile the program before you run it.",
        "whatToDo": [
          "Watch the Week 1 lecture and retype the small examples yourself.",
          "Get comfortable compiling and running a simple program.",
          "Begin Problem Set 1 once printing and variables make sense."
        ],
        "doneLooksLike": [
          "You can write, compile, and run a small C program.",
          "You understand variables, types, and basic loops in C.",
          "Problem Set 1 is finished and submitted."
        ],
        "reflectionPrompt": "What felt different about writing code in C compared with building in Scratch?"
      },
      "id": "week-1",
      "link": {
        "label": "Week 1 on CS50.harvard.edu",
        "url": "https://cs50.harvard.edu/x/weeks/1/"
